{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "**", "run": { "serviceId": "catchy-web", "region": "us-central1" } }
    ]
  },
  "emulators": {
    "singleProjectMode": true,
    "auth": { "host": "127.0.0.1", "port": 9199 },
    "firestore": { "host": "127.0.0.1", "port": 8180, "websocketPort": 9160 },
    "hub": { "host": "127.0.0.1", "port": 4410 },
    "logging": { "host": "127.0.0.1", "port": 4510 },
    "ui": { "enabled": true, "host": "127.0.0.1", "port": 4100 }
  }
}
