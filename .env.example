# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Firebase (Firestore + Auth) — all VITE_* are exposed to the client ---
# Create a web app in Firebase Console → Project settings → Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: map login form "admin" / "admin" to a real Firebase email user (enable Email/Password in Auth).
VITE_ADMIN_EMAIL=
VITE_ADMIN_PASSWORD=

# Optional: extra comma-separated emails that always get admin (defaults always include lojain2077 + marei.eyad).
# VITE_OWNER_EMAILS=coworker@gmail.com

# --- Firebase CLI (deploy hosting + Firestore rules) ---
# Copy .firebaserc.example to .firebaserc and replace YOUR_FIREBASE_PROJECT_ID with your real project id.
# Then: npm run firebase:login  →  npm run firebase:use  →  npm run firebase:deploy:rules  →  npm run firebase:deploy:hosting
#
# --- GitHub Actions (deploy as lojain2077@gmail.com’s Firebase project) ---
# Push this repo to GitHub, add the secrets listed in .github/workflows/deploy-firebase.yml,
# then run the workflow manually (Actions → Deploy Firebase Hosting → Run workflow).
