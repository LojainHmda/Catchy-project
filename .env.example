# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Firebase (Firestore + Auth) — all VITE_* are exposed to the client ---
# Create a web app in Firebase Console → Project settings → Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=catchy-496207
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Built-in admin login (see src/constants.tsx: ADMIN_DEMO_EMAIL / ADMIN_DEMO_PASSWORD) ---
# Default: admin@gmail.com / admin123 — auto-created on first sign-in if missing. Email/Password must be enabled in Firebase Auth.

# Optional: extra comma-separated emails that always get admin (defaults always include lojain2077 + marei.eyad).
# VITE_OWNER_EMAILS=coworker@gmail.com

# --- Firebase CLI (deploy hosting + Firestore rules) ---
# .firebaserc is committed with default project catchy-496207 (Firebase CLI deploy).
# Then: npm run firebase:login  →  npm run firebase:use  →  npm run firebase:deploy:rules  →  npm run firebase:deploy:hosting
#
# --- GCP Cloud Run (Dockerfile + nginx) ---
# `.gcloudignore` allows uploading root `.env` for the Cloud Build Vite step (do not commit `.env`).
# Run: npm run gcp:deploy  (needs gcloud; project catchy-496207).
#
# --- GitHub Actions (deploy as lojain2077@gmail.com’s Firebase project) ---
# Push this repo to GitHub, add the secrets listed in .github/workflows/deploy-firebase.yml,
# then run the workflow manually (Actions → Deploy Firebase Hosting → Run workflow).
