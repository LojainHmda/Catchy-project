rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email.matches('(?i)^(lojain2077@gmail\\.com|marei\\.eyad@gmail\\.com)$')
        || request.auth.token.email.matches('(?i)^[^@]+-catchy-496207@example\\.com$')
        || request.auth.token.email.matches('(?i)^admin@gmail\\.com$')
      );
    }

    // Hero video — public read, admin write
    match /hero/{filename} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Product media — public read, admin write.
    // New uploads must be videos of at most 100 MiB (104857600 bytes), the same
    // limit as src/lib/productVideoUpload.ts. Product images live in Cloudinary;
    // older images stored here before that (pre-Cloudinary) stay readable and an
    // admin can still delete anything in this folder.
    match /products/{filename} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.size <= 104857600
        && request.resource.contentType.matches('video/.*');
    }
  }
}
