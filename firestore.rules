rules_version = '2';
// Collections used by this app: products, hero_slides, site_settings/*, users/{uid}, orders/{id}
// After enabling Firestore in the Firebase console, deploy: npm run firebase:deploy:firestore
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    /** Synthetic admin email pattern `{name}-catchy-496207@example.com` (see AuthContext). */

    /** Email from the ID token (required for isOwner checks). */
    function authEmail() {
      return (signedIn() && request.auth.token.email is string)
        ? request.auth.token.email
        : '';
    }

    function isSyntheticShortcutAdmin() {
      return authEmail().matches('(?i)^[^@]+-catchy-496207@example\\.com$');
    }

    /** Demo admin — match case-insensitive so it matches AuthContext / constants. */
    function isDemoAdminShortcut() {
      return authEmail().matches('(?i)^admin@gmail\\.com$');
    }

    /** Owner accounts; email must appear on the JWT (sign out/in if you changed rules). */
    function isOwner() {
      return authEmail().matches('(?i)^(lojain2077@gmail\\.com|marei\\.eyad@gmail\\.com)$')
        || isSyntheticShortcutAdmin()
        || isDemoAdminShortcut();
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isOwner());
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if isOwner();
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /hero_slides/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /site_settings/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /orders/{id} {
      allow read, write: if signedIn();
    }
  }
}
