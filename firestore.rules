rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    /** Same owner emails as the app (lojain + Eyad). Google / email auth must expose `email` on the token. */
    function isOwner() {
      return signedIn()
        && request.auth.token.email != null
        && (
          request.auth.token.email == 'lojain2077@gmail.com'
          || request.auth.token.email == 'marei.eyad@gmail.com'
        );
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isOwner());
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if isOwner();
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /hero_slides/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /site_settings/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /orders/{id} {
      allow read, write: if signedIn();
    }
  }
}
