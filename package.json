{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000",
    "emulators": "powershell -ExecutionPolicy Bypass -File scripts/emulators.ps1",
    "dev:emulator": "powershell -ExecutionPolicy Bypass -File scripts/dev-emulator.ps1",
    "emulator:check": "node scripts/emulator/preflight.mjs",
    "emulator:verify": "node scripts/emulator/verify-identity.mjs",
    "emulator:seed": "node scripts/emulator/seed.mjs",
    "emulator:reset": "node scripts/emulator/reset.mjs",
    "start": "node server/index.js",
    "dev:android-reverse": "powershell -ExecutionPolicy Bypass -File scripts/reverse-android-dev.ps1",
    "setup:qz-tray": "powershell -ExecutionPolicy Bypass -File scripts/setup-qz-tray-windows.ps1",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "firebase:login": "firebase login",
    "firebase:use": "firebase use --add",
    "firebase:deploy": "npm run build && firebase deploy",
    "firebase:deploy:hosting": "npm run build && firebase deploy --only hosting",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules",
    "firebase:deploy:firestore": "firebase deploy --only firestore",
    "gcp:deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy-cloud-run.ps1",
    "gcp:deploy:firestore": "npx --yes firebase-tools@13 deploy --only firestore --project catchy-496207"
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^1.29.0",
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "eslint": "^10.2.1",
    "express": "^4.21.2",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.0.2",
    "framer-motion": "^12.38.0",
    "jsbarcode": "^3.12.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "qz-tray": "^2.2.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.72.1",
    "react-router-dom": "^7.14.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "autoprefixer": "^10.4.21",
    "firebase-tools": "^13.35.1",
    "jsdom": "^30.1.2",
    "node-forge": "^1.4.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^5.0.4"
  }
}
